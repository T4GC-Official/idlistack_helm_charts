# Patterns to ignore when building packages.
# This supports shell glob patterns, relative paths, and negation (prefixed with !)
# By default, helm ignores hidden files by starting with '.'
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
*.swp
*~
.DS_Store
*.orig
*.rej
*~
.idea/
.vscode/
*.log
test/
tests/
dist/
build/
docs/
examples/
node_modules/
vendor/
*.bak
*.tmp
*.temp
.env
.env.local
npm-debug.log
yarn-error.log
package-lock.json
